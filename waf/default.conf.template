# Journal d'acces (une ligne par requete) ecrit dans le volume partage app_logs,
# pour que Logstash le collecte. Format "combined" : IP, date, requete, code, taille, referer, navigateur.
# Pas d'en-tetes (donc pas de token Authorization), contrairement au log d'audit ModSecurity.

# Format "combined" + temps de traitement :
#   rt  = temps total de la requete (vu par le navigateur)
#   urt = temps de reponse de Kibana/backend (derriere le WAF)
# rt - urt = temps passe dans le WAF (ModSecurity + Nginx)
log_format timed '$remote_addr - $remote_user [$time_local] "$request" '
                 '$status $body_bytes_sent "$http_referer" "$http_user_agent" '
                 'rt=$request_time urt=$upstream_response_time';
access_log /var/log/app/waf.log timed;



map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

upstream frontend_upstream {
    server frontend:3000;
}

upstream backend_upstream {
    server backend:3000;
}

server {
    listen ${PORT} default_server;
    server_name ${SERVER_NAME};

    client_max_body_size 0;

    location / {
        return 301 https://$host:${SSL_PORT}$request_uri;
    }

}

server {
    listen ${SSL_PORT} ssl;
    server_name ${SERVER_NAME};

    ssl_certificate ${SSL_CERT_FILE};
    ssl_certificate_key ${SSL_CERT_KEY_FILE};
    ssl_protocols TLSv1.2 TLSv1.3;

    error_page 497 =301 https://$host:${SSL_PORT}$request_uri;

    client_max_body_size 0;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    server_tokens off;

    location /api/ {
        proxy_pass http://backend_upstream/;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_http_version 1.1;
        proxy_read_timeout 3600s;
    }

    location /socket.io/ {
        proxy_pass http://backend_upstream/socket.io/;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_http_version 1.1;
        proxy_read_timeout 3600s;
    }

    location /kibana {
        # Kibana est un outil d'administration, pas une partie du site : le WAF ne l'attend pas
        # au demarrage (pas de bloc upstream, pas de depends_on). L'adresse est resolue a chaque
        # requete via la variable : si Kibana est absent, seul /kibana/ repond 502, le site reste
        # disponible. Frontend et backend, eux, sont indispensables : le WAF les attend.
        
        set $kibana_backend http://kibana:5601;
        proxy_pass $kibana_backend;
        proxy_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_http_version 1.1;
        proxy_read_timeout 3600s;
    }

    # Next.js dev server advertises a Chrome DevTools workspace pointing to the
    # container path /app, which does not exist on the host and logs an error.
    location = /.well-known/appspecific/com.chrome.devtools.json {
        return 404;
    }

    location / {
        proxy_pass http://frontend_upstream;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_http_version 1.1;
        proxy_read_timeout 3600s;
    }

    location /grafana {
        set $grafana_backend http://grafana:3000;
        proxy_pass $grafana_backend;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_http_version 1.1;
        proxy_read_timeout 3600s;
    }
}
