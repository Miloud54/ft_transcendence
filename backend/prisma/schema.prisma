// to apply the changes to the actual db
// new cmd:
// docker compose exec backend sh -c '. <(npx tsx scripts/load-vault-env.ts) && npx prisma migrate deploy

//to visualize it in browser run docker compose exec backend npx prisma studio 

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ONLINE
  OFFLINE
  IN_GAME
}

enum RoomStatus {
  OPEN
  STARTING
  IN_GAME
  CLOSED
}

enum GameStatus {
  COUNTDOWN
  RUNNING
  FINISHED
}

//Users, Rooms, Room_players, Games et Game_players.
//can also use @default(autoincrement()) → 1, 2, 3, 4...
//uuid() set random id like a3f9c1e2-...
//string is varchar(255) by default, can change it with @db.VarChar(200)

model User {
  user_id   BigInt @id @default(autoincrement())
  username  String @unique
  email     String @unique
  password  String? 
  avatar    String
  xp        BigInt
  lvl       BigInt
  status    UserStatus

  rooms     RoomPlayer[]
  games     GamePlayer[]
  rooms_created Room[]
	@@map("Users")
}

model Room {
  room_id     BigInt @id @default(autoincrement())
  status      RoomStatus 
  min_players Int
  max_players Int
  created_at  DateTime? @default(now())  
  closed_at   DateTime?

  //one side in one to many
  creator_id  BigInt
  creator     User @relation(fields: [creator_id], references: [user_id])

  players     RoomPlayer[]
  games_hosted Game[]
	@@map("Rooms")
}

model Game {
  game_id     BigInt @id @default(autoincrement())
  //wikipage_id BigInt
  status      GameStatus
  started_at  DateTime?
  ended_at    DateTime?

  room_id     BigInt
  room        Room @relation(fields: [room_id], references: [room_id])

  player      GamePlayer[]
	@@map("Games")
}

// tables intermediaires pour many-to-many
model RoomPlayer {
  room_player_id BigInt @id @default(autoincrement())

  room_id   BigInt
  room      Room @relation(fields: [room_id], references: [room_id])

  user_id   BigInt
  users     User @relation(fields: [user_id], references: [user_id])

  @@unique([room_id, user_id])
	@@map("Room_players")
}

model GamePlayer {
  game_player_id      BigInt @id @default(autoincrement())

  game_id BigInt
  game    Game @relation(fields: [game_id], references: [game_id])

  user_id BigInt
  users   User @relation(fields: [user_id], references: [user_id])

    @@unique([game_id, user_id])
	@@map("Game_players")
}